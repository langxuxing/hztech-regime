# 本地数据目录（默认 ./data，与 algorithm/ 同级；含 db/cache/exports/logs 子目录）
# DATA_DIR=/path/to/Regime&Trend/data

# LLM（OpenAI 兼容接口，支持 Gemini OpenAI 兼容端点）
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# 交易所（公开接口无需 Key；Binance demo 见下方）
EXCHANGE=binance
SYMBOL=BTC/USDT:USDT

# Binance USD-M 配置（与 biance-ws/alang_demo.json 格式相同）
# 未设置时自动尝试 ../CreativeIdeaLab/biance-ws/alang_demo.json
# BINANCE_CONFIG_PATH=/Volumes/HZTech/CreativeIdeaLab/biance-ws/alang_demo.json
# 或用环境变量覆盖（勿提交到 git）：
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_FAPI_BASE_URL=https://demo-fapi.binance.com
# BINANCE_SANDBOX=true

# CoinGlass（经济日历 + 新闻，Startup 及以上套餐）
COINGLASS_API_KEY=
COINGLASS_EXCHANGE_LIST=Binance,OKX,Bybit,Bitget,Gate

# X (Twitter) API v2 — 突发事件监控
X_BEARER_TOKEN=
# 可选：自定义搜索 query（默认监控 BTC/ETF/Fed/SEC 等）
# X_SEARCH_QUERY=(bitcoin OR BTC OR ETF OR FOMC) -is:retweet lang:en
X_MAX_RESULTS=30

# 事件引擎
EVENT_DEMO_MODE=false
EVENT_MIN_BTC_RELEVANCE=0.35
EVENT_POLL_INTERVAL_SEC=300
EVENT_LLM_MAX_CALLS=3

# 可选：CreativeIdeaLab 本地 PEPE 1m 数据目录
# PEPEDATA_DIR=/Volumes/HZTech/CreativeIdeaLab/OHLCV/Pepe

# 可选：本地 Spot ETF 日度净流入 CSV（scripts/download_etf.sh 生成）
# ETFDATA_DIR=/path/to/Regime&Trend/data/ETF

# 数据同步定时器（./scripts/start-sync-scheduler.sh）
# SYNC_HOUR=8
# SYNC_MINUTE=0
# SYNC_TIMEZONE=Asia/Shanghai
# SYNC_ON_START=0          # 1=启动调度器时立即同步一次
# SYNC_ETF_DAYS=14         # Farside ETF 回溯天数
# SYNC_OHLCV_DAYS=3        # BTC 15m K 线回溯天数
# SYNC_COINGLASS_DAYS=7    # CoinGlass ETF 回溯天数（需 COINGLASS_API_KEY）
# SYNC_SKIP_COINGLASS=0    # 1=跳过 CoinGlass ETF

# BTC 1m 定时下载（./scripts/start-btc-1m-scheduler.sh）
# BTC_1M_INTERVAL_SEC=300  # 拉取间隔（秒），默认 5 分钟
# BTC_1M_ON_START=1        # 1=启动调度器时立即下载一次
# BTC_1M_OUT_DIR=/path/to/Regime&Trend/data/OHLCV/Btc

# Spot taker CVD（Binance 现货 taker buy/sell 拆分；OKX 无 taker 字段时走 Binance 参考流）
USE_TAKER_CVD=true
TAKER_CVD_EXCHANGE=binance

# 看板快照（API 默认读缓存；独立 worker 定时刷新）
SNAPSHOT_POLL_INTERVAL_SEC=120
SNAPSHOT_STALE_SEC=300
SNAPSHOT_WARMUP_ON_START=true
# API 内嵌快照轮询（0=由 snapshot-worker 负责，推荐）
POLL_SNAPSHOTS=0

# 可选：保护 /api/* 端点（留空=不启用，本地开发无需设置）
# API_KEY=your-secret-key

# Flutter 构建时传入: flutter run --dart-define=API_KEY=your-secret-key
